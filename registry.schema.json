{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Icaro0310/devin-powerups/registry.schema.json",
  "title": "devin-powerups registry",
  "description": "Machine-readable catalog of the Icaro0310 devin-* ecosystem: public projects plus clearly marked maintainer-only records.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generated", "owner", "repositories"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Registry format/content version, bumped on structural changes."
    },
    "generated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO date the registry was last regenerated."
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "GitHub account that owns the listed repositories."
    },
    "note": {
      "type": "string",
      "description": "Free-form maintainer note about catalog scope."
    },
    "ci": {
      "type": "object",
      "description": "Ecosystem-wide CI architecture documentation.",
      "additionalProperties": false,
      "properties": {
        "architecture": {"type": "string"},
        "previous_architecture": {"type": "string"},
        "reason": {"type": "string"},
        "shape": {"type": "string"},
        "status_doc": {"type": "string"}
      }
    },
    "known_issues": {
      "type": "array",
      "items": {"type": "string"}
    },
    "devkit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "installer", "supported_platforms", "planned_platforms", "git_required_tools", "tools", "profiles"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "installer": {"enum": ["uv"]},
        "supported_platforms": {
          "type": "array",
          "items": {"enum": ["windows", "linux", "macos"]},
          "minItems": 1
        },
        "planned_platforms": {
          "type": "array",
          "items": {"enum": ["windows", "linux", "macos"]}
        },
        "git_required_tools": {
          "type": "array",
          "items": {"type": "string"}
        },
        "tools": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manager", "source", "package", "version", "commands", "runtime", "platforms", "status", "category"],
            "properties": {
              "manager": {"enum": ["uv", "npm", "manual"]},
              "source": {"enum": ["pypi", "github", "npm", "manual"]},
              "package": {"type": "string", "minLength": 1},
              "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
              "commands": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "minItems": 1
              },
              "runtime": {"type": "string", "minLength": 1},
              "platforms": {
                "type": "array",
                "items": {"enum": ["windows", "linux", "macos"]},
                "minItems": 1
              },
              "status": {"enum": ["published", "source", "manual"]},
              "category": {"type": "string", "minLength": 1},
              "ref": {"type": "string", "minLength": 1},
              "extras": {"type": "array", "items": {"type": "string"}},
              "manual_note": {"type": "string"}
            }
          }
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "description", "tools"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "tools": {"type": "array", "items": {"type": "string"}},
              "manual": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "alias_of": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url",
          "kind",
          "artifact",
          "interfaces",
          "audiences",
          "visibility",
          "wave",
          "status",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$",
            "description": "Canonical https GitHub URL (<owner>/<repo>)."
          },
          "kind": {
            "enum": ["project", "infra", "distribution", "system"],
            "description": "Structural role: project = repository catalog entry; infra = maintainer hub/meta; distribution = installable ecosystem layer; system = private maintainer runtime."
          },
          "artifact": {
            "enum": ["tool", "service", "suite", "resource", "distribution", "infrastructure", "system"],
            "description": "User-facing artifact classification. A repository is an artifact; artifact=tool means an installable or source-runnable user-facing product, service means a long-running app, suite means a multi-component collection, resource means documentation/discovery, distribution/infrastructure mean packaging or maintainer layers, and system means a private runtime/component."
          },
          "interfaces": {
            "type": "array",
            "items": {"enum": ["cli", "library", "service", "dashboard", "mcp", "bridge", "installer", "registry", "docs", "automation"]},
            "minItems": 1,
            "description": "Public or maintainer-facing interfaces exposed by the artifact."
          },
          "audiences": {
            "type": "array",
            "items": {"enum": ["qa", "developers", "security", "operations", "ai-engineers", "maintainers", "end-users"]},
            "minItems": 1,
            "description": "Primary audiences the artifact serves."
          },
          "platforms": {
            "type": "array",
            "items": {"enum": ["windows", "linux", "macos"]},
            "minItems": 1,
            "description": "Operating systems the artifact is documented and tested for. Omit for platform-agnostic documentation/resources."
          },
          "visibility": {
            "enum": ["public", "private"]
          },
          "wave": {
            "type": "integer",
            "minimum": 0,
            "description": "Delivery wave; 0 = hub/standalone entries."
          },
          "status": {
            "enum": ["active", "delivered"]
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "Current semantic version (without leading v)."
          },
          "session": {
            "type": "string",
            "minLength": 1,
            "description": "Devin session id/slug that delivered the repo."
          },
          "stack": {
            "enum": ["python", "node"]
          },
          "ci": {
            "enum": ["inline"],
            "description": "CI architecture used by the repo (inline = self-contained ci.yml)."
          },
          "tests": {
            "type": "integer",
            "minimum": 0,
            "description": "Test count at time of cataloging."
          },
          "tag": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "Published git tag, when one was pushed."
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "description": "Absorption/rename notes (e.g. 'absorbed devin-dashboard')."
          },
          "local_dir": {
            "type": "string",
            "minLength": 1,
            "description": "Maintainer-local checkout path, relative to this repo."
          },
          "tests_dir": {
            "type": "string",
            "minLength": 1,
            "description": "Directory holding tests for non-standard layouts."
          }
        }
      }
    }
  }
}
