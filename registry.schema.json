{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Icaro0310/devin-powerups/registry.schema.json",
  "title": "devin-powerups registry",
  "description": "Machine-readable catalog of the Icaro0310 devin-* ecosystem: public projects plus clearly marked maintainer-only records.",
  "type": "object",
  "$defs": {
    "environmentSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "runtime", "delegation", "external_dependencies"],
      "properties": {
        "supported": {"type": "boolean"},
        "runtime": {"enum": ["extended", "local-only", "unavailable"]},
        "delegation": {"enum": ["optional", "supported", "required", "forbidden", "unavailable"]},
        "external_dependencies": {"type": "boolean"},
        "requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"supported": {"const": false}},
            "required": ["supported"]
          },
          "then": {
            "required": ["reason"],
            "properties": {
              "runtime": {"const": "unavailable"},
              "delegation": {"const": "forbidden"}
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": ["version", "generated", "owner", "environments", "repositories"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Registry format/content version, bumped on structural changes."
    },
    "generated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO date the registry was last regenerated."
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "GitHub account that owns the listed repositories."
    },
    "note": {
      "type": "string",
      "description": "Free-form maintainer note about catalog scope."
    },
    "ci": {
      "type": "object",
      "description": "Ecosystem-wide CI architecture documentation.",
      "additionalProperties": false,
      "properties": {
        "architecture": {"type": "string"},
        "previous_architecture": {"type": "string"},
        "reason": {"type": "string"},
        "shape": {"type": "string"},
        "status_doc": {"type": "string"}
      }
    },
    "known_issues": {
      "type": "array",
      "items": {"type": "string"}
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linux", "personal_windows", "corporate_windows"],
      "properties": {
        "linux": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "runtime", "delegation", "local_only", "external_compute", "devkit"],
          "properties": {
            "label": {"type": "string", "minLength": 1},
            "runtime": {"enum": ["extended", "local-only", "unavailable"]},
            "delegation": {"enum": ["optional", "supported", "required", "forbidden", "unavailable"]},
            "local_only": {"type": "boolean"},
            "external_compute": {"type": "boolean"},
            "devkit": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "personal_windows": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "runtime", "delegation", "local_only", "external_compute", "devkit"],
          "properties": {
            "label": {"type": "string", "minLength": 1},
            "runtime": {"enum": ["extended", "local-only", "unavailable"]},
            "delegation": {"enum": ["optional", "supported", "required", "forbidden", "unavailable"]},
            "local_only": {"type": "boolean"},
            "external_compute": {"type": "boolean"},
            "devkit": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1}
          }
        },
        "corporate_windows": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "runtime", "delegation", "local_only", "external_compute", "devkit"],
          "properties": {
            "label": {"type": "string", "minLength": 1},
            "runtime": {"enum": ["extended", "local-only", "unavailable"]},
            "delegation": {"enum": ["optional", "supported", "required", "forbidden", "unavailable"]},
            "local_only": {"type": "boolean"},
            "external_compute": {"type": "boolean"},
            "devkit": {"type": "string", "minLength": 1},
            "description": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "devkit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "installer", "supported_platforms", "planned_platforms", "git_required_tools", "tools", "profiles"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "installer": {"enum": ["uv"]},
        "supported_platforms": {
          "type": "array",
          "items": {"enum": ["windows", "linux", "macos"]},
          "minItems": 1
        },
        "planned_platforms": {
          "type": "array",
          "items": {"enum": ["windows", "linux", "macos"]}
        },
        "git_required_tools": {
          "type": "array",
          "items": {"type": "string"}
        },
        "tools": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manager", "source", "package", "version", "commands", "runtime", "platforms", "status", "category"],
            "properties": {
              "manager": {"enum": ["uv", "npm", "manual"]},
              "source": {"enum": ["pypi", "github", "npm", "manual"]},
              "package": {"type": "string", "minLength": 1},
              "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
              "commands": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "minItems": 1
              },
              "runtime": {"type": "string", "minLength": 1},
              "platforms": {
                "type": "array",
                "items": {"enum": ["windows", "linux", "macos"]},
                "minItems": 1
              },
              "status": {"enum": ["published", "source", "manual"]},
              "category": {"type": "string", "minLength": 1},
              "ref": {"type": "string", "minLength": 1},
              "extras": {"type": "array", "items": {"type": "string"}},
              "manual_note": {"type": "string"}
            }
          }
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "description", "tools"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "tools": {"type": "array", "items": {"type": "string"}},
              "manual": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "alias_of": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url",
          "kind",
          "artifact",
          "interfaces",
          "audiences",
          "visibility",
          "public",
          "wave",
          "status",
          "maturity",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$",
            "description": "Canonical https GitHub URL (<owner>/<repo>)."
          },
          "kind": {
            "enum": ["project", "infra", "distribution", "system"],
            "description": "Structural role: project = repository catalog entry; infra = maintainer hub/meta; distribution = installable ecosystem layer; system = private maintainer runtime."
          },
          "artifact": {
            "enum": ["tool", "service", "suite", "resource", "distribution", "infrastructure", "system"],
            "description": "User-facing artifact classification. A repository is an artifact; artifact=tool means an installable or source-runnable user-facing product, service means a long-running app, suite means a multi-component collection, resource means documentation/discovery, distribution/infrastructure mean packaging or maintainer layers, and system means a private runtime/component."
          },
          "interfaces": {
            "type": "array",
            "items": {"enum": ["cli", "library", "service", "dashboard", "mcp", "bridge", "installer", "registry", "docs", "automation"]},
            "minItems": 1,
            "description": "Public or maintainer-facing interfaces exposed by the artifact."
          },
          "audiences": {
            "type": "array",
            "items": {"enum": ["qa", "developers", "security", "operations", "ai-engineers", "maintainers", "end-users"]},
            "minItems": 1,
            "description": "Primary audiences the artifact serves."
          },
          "platforms": {
            "type": "array",
            "items": {"enum": ["windows", "linux", "macos"]},
            "minItems": 1,
            "description": "Operating systems the artifact is documented and tested for. Omit for platform-agnostic documentation/resources."
          },
          "environments": {
            "type": "object",
            "additionalProperties": false,
            "required": ["linux", "personal_windows", "corporate_windows"],
            "properties": {
              "linux": {"$ref": "#/$defs/environmentSupport"},
              "personal_windows": {"$ref": "#/$defs/environmentSupport"},
              "corporate_windows": {
                "allOf": [
                  {"$ref": "#/$defs/environmentSupport"},
                  {
                    "if": {
                      "properties": {"supported": {"const": true}},
                      "required": ["supported"]
                    },
                    "then": {
                      "properties": {
                        "runtime": {"const": "local-only"},
                        "delegation": {"enum": ["forbidden", "unavailable"]},
                        "external_dependencies": {"const": false}
                      }
                    }
                  }
                ]
              }
            },
            "description": "Runtime capability per supported environment (linux, personal_windows, corporate_windows)."
          },
          "visibility": {
            "enum": ["public", "private"]
          },
          "wave": {
            "type": "integer",
            "minimum": 0,
            "description": "Delivery wave; 0 = hub/standalone entries."
          },
          "status": {
            "enum": ["active", "delivered"]
          },
          "public": {
            "type": "boolean",
            "description": "Mirrors `visibility`: true for public entries, false otherwise. Public generators read this flag."
          },
          "nature": {
            "enum": ["product", "infrastructure", "distribution", "surface", "fixture"],
            "description": "What the entry is. product = user-facing tool, service or suite; infrastructure = foundation or maintainer layer other entries rely on; distribution = install channel; surface = discovery or navigation content (catalog, profile, site); fixture = synthetic data and generators used by tests, evals and demos. Independent of the structural `kind`."
          },
          "track": {
            "enum": ["observe", "assure", "guard", "platform", "navigation", "foundation", "related"],
            "description": "Primary public placement; an editorial classification, not a claim that one package implements it. observe = what happened in the agent and in the local data; assure = can the result be verified, measured and judged; guard = how execution is controlled and data protected; platform = how the ecosystem is installed, governed and distributed. navigation, foundation and related are supporting layers, not product tracks: navigation holds discovery surfaces, foundation holds entries that belong only to the foundation layer, related holds optional or adjacent projects and projects kept outside the main path."
          },
          "role": {
            "enum": ["flagship", "module", "foundation", "installer", "catalog", "surface"],
            "description": "Function inside the track. flagship = the public entry point of the ecosystem; module = a focused tool or fixture set; foundation = a layer other entries rely on (it also marks an entry that belongs to the foundation layer while sitting in a product track); installer = an install channel; catalog = inventory and governance functionality; surface = discovery content."
          },
          "mode": {
            "enum": ["read", "write", "mixed"],
            "description": "Mutation behavior of the entry's own executable surface. read = never modifies Devin stores, Devin or user configuration, or existing user files; it may write derived outputs of its own (exports, reports, indexes, caches), and passive content such as docs or manifests counts as read. write = its purpose is to modify data it does not own. mixed = read-only analysis plus explicit mutating commands, guarded (dry-run first, confirmation or an explicit apply flag) where supported."
          },
          "maturity": {
            "enum": ["experimental", "usable", "stable"],
            "description": "experimental = interfaces and behavior may change without notice and unattended use is not advised; usable = documented, tested in CI and installable through a supported path, interfaces may still change before 1.0; stable = a compatibility commitment designated by the maintainer."
          },
          "distribution_status": {
            "enum": ["published", "source_only", "pending"],
            "description": "How the artifact is distributed: published = a versioned package-registry release exists (PyPI, npm) and docs may prescribe it as the canonical install; source_only = install is git checkout only, no release verification or immutable version; pending = publication planned but not done. Required on public products and fixtures."
          },
          "is_control_plane": {
            "type": "boolean",
            "default": false,
            "description": "True for the one entry that holds the semantic registry and governance rules. Absent means false."
          },
          "official_overlap": {
            "enum": ["none", "partial", "high"],
            "description": "Editorial and governance field: how much the entry's concept overlaps an official Devin feature. It does not imply technical incompatibility or competition. none = no meaningful conceptual overlap; partial = overlaps an official concept but adds a distinct local, evidence or governance function; high = substantially the same function."
          },
          "overlap_note": {
            "type": ["string", "null"],
            "minLength": 1,
            "description": "null when official_overlap is none; otherwise one sentence naming the official feature and what the entry adds."
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "Current semantic version (without leading v)."
          },
          "session": {
            "type": "string",
            "minLength": 1,
            "description": "Devin session id/slug that delivered the repo."
          },
          "stack": {
            "enum": ["python", "node"]
          },
          "ci": {
            "enum": ["inline"],
            "description": "CI architecture used by the repo (inline = self-contained ci.yml)."
          },
          "tests": {
            "type": "integer",
            "minimum": 0,
            "description": "Test count at time of cataloging."
          },
          "tag": {
            "type": "string",
            "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "Published git tag, when one was pushed."
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "description": "Absorption/rename notes (e.g. 'absorbed devin-dashboard')."
          },
          "local_dir": {
            "type": "string",
            "minLength": 1,
            "description": "Maintainer-local checkout path, relative to this repo."
          },
          "tests_dir": {
            "type": "string",
            "minLength": 1,
            "description": "Directory holding tests for non-standard layouts."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "visibility": {"const": "public"},
                "artifact": {"enum": ["tool", "service", "suite", "distribution", "infrastructure"]}
              },
              "required": ["visibility", "artifact"]
            },
            "then": {"required": ["platforms", "environments"]}
          },
          {
            "description": "public entries are fully classified",
            "if": {"properties": {"visibility": {"const": "public"}}, "required": ["visibility"]},
            "then": {"required": ["nature", "track", "role", "mode", "official_overlap", "overlap_note"]}
          },
          {
            "description": "public products and fixtures declare distribution status",
            "if": {"properties": {"visibility": {"const": "public"}, "nature": {"enum": ["product", "fixture"]}}, "required": ["visibility", "nature"]},
            "then": {"required": ["distribution_status"]}
          },
          {
            "description": "public mirrors visibility",
            "if": {"properties": {"visibility": {"const": "public"}}, "required": ["visibility"]},
            "then": {"properties": {"public": {"const": true}}},
            "else": {"properties": {"public": {"const": false}}}
          },
          {
            "description": "overlap_note is null when official_overlap is none",
            "if": {"properties": {"official_overlap": {"const": "none"}}, "required": ["official_overlap"]},
            "then": {"properties": {"overlap_note": {"type": "null"}}}
          },
          {
            "description": "partial or high overlap needs a note naming the official feature",
            "if": {"properties": {"official_overlap": {"enum": ["partial", "high"]}}, "required": ["official_overlap"]},
            "then": {"required": ["overlap_note"], "properties": {"overlap_note": {"type": "string"}}}
          },
          {
            "description": "the control plane is the platform foundation infrastructure entry",
            "if": {"properties": {"is_control_plane": {"const": true}}, "required": ["is_control_plane"]},
            "then": {
              "required": ["track", "role", "nature"],
              "properties": {"track": {"const": "platform"}, "role": {"const": "foundation"}, "nature": {"const": "infrastructure"}}
            }
          },
          {
            "description": "a surface is a passive navigation entry",
            "if": {"properties": {"nature": {"const": "surface"}}, "required": ["nature"]},
            "then": {"properties": {"track": {"const": "navigation"}, "role": {"const": "surface"}, "mode": {"const": "read"}}}
          },
          {
            "description": "the navigation track holds surfaces only",
            "if": {"properties": {"track": {"const": "navigation"}}, "required": ["track"]},
            "then": {"properties": {"nature": {"const": "surface"}, "role": {"const": "surface"}}}
          },
          {
            "description": "the surface role belongs to surfaces",
            "if": {"properties": {"role": {"const": "surface"}}, "required": ["role"]},
            "then": {"properties": {"nature": {"const": "surface"}}}
          },
          {
            "description": "a distribution is an installer in the platform track",
            "if": {"properties": {"nature": {"const": "distribution"}}, "required": ["nature"]},
            "then": {"properties": {"track": {"const": "platform"}, "role": {"const": "installer"}}}
          },
          {
            "description": "the installer role belongs to distributions",
            "if": {"properties": {"role": {"const": "installer"}}, "required": ["role"]},
            "then": {"properties": {"nature": {"const": "distribution"}}}
          },
          {
            "description": "infrastructure plays the foundation role",
            "if": {"properties": {"nature": {"const": "infrastructure"}}, "required": ["nature"]},
            "then": {"properties": {"role": {"const": "foundation"}}}
          },
          {
            "description": "the foundation role belongs to infrastructure",
            "if": {"properties": {"role": {"const": "foundation"}}, "required": ["role"]},
            "then": {"properties": {"nature": {"const": "infrastructure"}}}
          },
          {
            "description": "the foundation track holds foundation infrastructure",
            "if": {"properties": {"track": {"const": "foundation"}}, "required": ["track"]},
            "then": {"properties": {"role": {"const": "foundation"}, "nature": {"const": "infrastructure"}}}
          },
          {
            "description": "the catalog role is platform governance functionality shipped as a product",
            "if": {"properties": {"role": {"const": "catalog"}}, "required": ["role"]},
            "then": {"properties": {"track": {"const": "platform"}, "nature": {"const": "product"}}}
          },
          {
            "description": "the flagship is a product in a product track",
            "if": {"properties": {"role": {"const": "flagship"}}, "required": ["role"]},
            "then": {"properties": {"nature": {"const": "product"}, "track": {"enum": ["observe", "assure", "guard"]}}}
          },
          {
            "description": "a fixture is a read-only module of the assure track",
            "if": {"properties": {"nature": {"const": "fixture"}}, "required": ["nature"]},
            "then": {"properties": {"track": {"const": "assure"}, "role": {"const": "module"}, "mode": {"const": "read"}}}
          },
          {
            "description": "a module is a product or a fixture",
            "if": {"properties": {"role": {"const": "module"}}, "required": ["role"]},
            "then": {"properties": {"nature": {"enum": ["product", "fixture"]}}}
          },
          {
            "description": "the related track holds product modules",
            "if": {"properties": {"track": {"const": "related"}}, "required": ["track"]},
            "then": {"properties": {"role": {"const": "module"}, "nature": {"const": "product"}}}
          }
        ]
      }
    }
  }
}
